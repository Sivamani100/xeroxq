# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-desktop/
/out/

# production
/dist/
dist/
# Binaries — ignore build scratch & standalone .exe/.apk, allow published landing installers via LFS
/release_build/
release_build/
*.exe
*.apk
xeroxq_user_app/build/
public/downloads/*
!public/downloads/*.exe

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
